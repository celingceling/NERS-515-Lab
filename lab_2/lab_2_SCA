import struct
import numpy as np
import matplotlib.pyplot as plt

def style_axis(ax):
    ax.grid(False)
    ax.tick_params(axis='both', which='both', direction='in', length=6, width=1.2)

# ============================================================
# Figure: Integrator mode (stacked subplots, with error bars)
# ============================================================
sca_input_amplitude = np.array([3150, 5125, 7175, 7875, 9975])   # mV
amp_err              = 25.4   # mV, sigma_m, constant across all trials
max_lld_setting      = np.array([3000, 5620, 7050, 7700, 9900])  # mV
sca_rise_time        = np.array([684, 710, 660, 780, 680])       # ns
rise_err             = 86.0   # ns, constant across all trials

fig1, (ax1, ax2) = plt.subplots(2, 1, figsize=(8, 11))

ax1.errorbar(sca_input_amplitude, max_lld_setting, xerr=amp_err, fmt='o-',
             linewidth=2, markersize=8, capsize=4, label='Data')
ax1.set_xlabel('SCA Input Amplitude (mV)', fontsize=12, fontweight='bold')
ax1.set_ylabel('Maximum LLD Setting (mV)', fontsize=12, fontweight='bold')
ax1.set_title('SCA Input Amplitude vs Maximum LLD Setting', fontsize=12, fontweight='bold')
ax1.legend(loc='best', fontsize=10)
style_axis(ax1)

ax2.errorbar(sca_input_amplitude, sca_rise_time, xerr=amp_err, yerr=rise_err, fmt='o-',
             linewidth=2, markersize=8, capsize=4, color='orange', label='Data')
ax2.set_xlabel('SCA Input Amplitude (mV)', fontsize=12, fontweight='bold')
ax2.set_ylabel('SCA Rise Time (ns)', fontsize=12, fontweight='bold')
ax2.set_title('SCA Rise Time vs SCA Input Amplitude', fontsize=12, fontweight='bold')
ax2.legend(loc='best', fontsize=10)
style_axis(ax2)

fig1.tight_layout()
fig1.savefig('graph_integrator.png', dpi=300)
plt.close(fig1)

# ============================================================
# Figure: Window mode -- range of input pulse heights vs window width
# (all three LLD settings on one graph, per Section 2.2.2 of the manual)
# ============================================================
window_data = {
    '6.83 V': {'setting': [2.4, 3.1, 4.5], 'vmin': [5.83,5.83,5.83], 'vmax': [5.99,6.05,6.17]},
    '8.0 V':  {'setting': [2.4, 3.1, 4.5], 'vmin': [6.84,6.84,6.84], 'vmax': [6.98,7.05,7.16]},
    '4.0 V':  {'setting': [2.4, 3.1, 4.5], 'vmin': [3.4, 3.4, 3.4 ], 'vmax': [3.56,3.62,3.75]},
}
colors = ['tab:blue', 'tab:green', 'tab:red']

fig2, ax3 = plt.subplots(figsize=(8,6))
for (lld, d), c in zip(window_data.items(), colors):
    nominal_width = [s/10.0 for s in d['setting']]          # dial setting -> volts (setting/10)
    measured_width = [vx - vn for vx, vn in zip(d['vmax'], d['vmin'])]
    ax3.plot(nominal_width, measured_width, 'o-', linewidth=2, markersize=8, color=c,
             label=f'LLD = {lld}')

lims = [0, 0.5]
ax3.plot(lims, lims, 'k--', linewidth=1, label='1:1 reference')

ax3.set_xlabel('Nominal Window Width Setting (V)', fontsize=12, fontweight='bold')
ax3.set_ylabel('Measured Pulse-Height Range ($V_{max}-V_{min}$) (V)', fontsize=12, fontweight='bold')
ax3.set_title('Window-Mode SCA: Measured Range vs Window Width', fontsize=12, fontweight='bold')
ax3.legend(loc='best', fontsize=9)
style_axis(ax3)
fig2.tight_layout()
fig2.savefig('graph_window.png', dpi=300)
plt.close(fig2)

# ============================================================
# Figure: Normal mode (Vmin/Vmax vs upper-level setting, per LLD)
# ============================================================
normal_data = {
    '4.0 V': {'upper': [5.0,6.0,8.5],  'vmin':[3.4,3.4,3.4],   'vmax':[4.18,5.05,7.22]},
    '2.5 V': {'upper': [4.0,6.0,10.0], 'vmin':[2.09,2.09,2.09],'vmax':[3.32,5.12,8.53]},
    '6.5 V': {'upper': [7.0,8.6,10.0], 'vmin':[5.55,5.55,5.55],'vmax':[5.93,7.29,8.53]},
}
fig3, ax4 = plt.subplots(figsize=(8,6))
for (lld, d), c in zip(normal_data.items(), colors):
    ax4.plot(d['upper'], d['vmax'], 'o-', linewidth=2, markersize=8, color=c, label=f'LLD = {lld} ($V_{{max}}$)')
    ax4.plot(d['upper'], d['vmin'], 's--', linewidth=1.5, markersize=7, color=c, label=f'LLD = {lld} ($V_{{min}}$)')
ax4.set_xlabel('Upper-Level Setting (V)', fontsize=12, fontweight='bold')
ax4.set_ylabel('Discriminated Pulse Amplitude (V)', fontsize=12, fontweight='bold')
