style_axis(ax4)
fig3.tight_layout()
fig3.savefig('graph_normal.png', dpi=300)
plt.close(fig3)

# ============================================================
# Parse the 9 .Chn MCA spectra (needed for the remaining MCA plots)
# NOTE: requires lab2_3_2_1_1.Chn ... lab2_3_2_1_9.Chn in the same folder
# ============================================================
rows = [
 (10,   '1.0 V',   2.62),
 (10,   '3.0 V',   4.68),
 (10,   '0.5 V',   0.671),
 (11.8, '820 mV',  1.3),
 (11.8, '1.5 V',   2.3),
 (11.8, '2.71 V',  3.9),
 (13.6, '28.6 mV', 0.4962),
 (13.6, '4.1 V',   7.04),
 (13.6, '1.5 V',   2.7),
]

spectra = []
for i in range(1,10):
    fn = f'lab2_3_2_1_{i}.Chn'
    with open(fn,'rb') as f:
        data = f.read()
    realtime, livetime = struct.unpack_from('<II', data, 8)
    offset_ch, num_ch = struct.unpack_from('<HH', data, 28)
    counts = np.array(struct.unpack_from('<%dI' % num_ch, data, 32))
    peak_ch = int(np.argmax(counts))
    lo, hi = max(0,peak_ch-15), min(num_ch,peak_ch+16)
    net = int(counts[lo:hi].sum())
    live_s = livetime*0.02
    spectra.append(dict(gain=rows[i-1][0], v0=rows[i-1][1], vmeas=rows[i-1][2],
                         counts=counts, peak_ch=peak_ch, net=net, live_s=live_s,
                         rate=net/live_s))

gains = sorted(set(s['gain'] for s in spectra))
gain_colors = {10:'tab:blue', 11.8:'tab:green', 13.6:'tab:red'}

# ---- Figure: recreated MCA spectra (counts vs channel, zoomed, per gain) ----
fig4, axes = plt.subplots(1, 3, figsize=(16,5), sharey=True)
for ax, g in zip(axes, gains):
    runs = [s for s in spectra if s['gain']==g]
    for s in runs:
        lo, hi = max(0, s['peak_ch']-40), s['peak_ch']+41
        ch = np.arange(lo, hi)
        ax.plot(ch, s['counts'][lo:hi], linewidth=1.5,
                label=f"$V_0$={s['v0']} ({s['vmeas']} V meas.)")
    ax.set_xlabel('MCA Channel Number', fontsize=11, fontweight='bold')
    ax.set_title(f'Amplifier Gain = {g}', fontsize=11, fontweight='bold')
    ax.legend(loc='best', fontsize=8)
    style_axis(ax)
axes[0].set_ylabel('Counts', fontsize=11, fontweight='bold')
fig4.tight_layout()
fig4.savefig('graph_mca_spectra.png', dpi=300)
plt.close(fig4)

# ---- Figure: amplitude & net count rate vs channel number, 3 gains, with linear fit + R^2 ----
fit_pts = [s for s in spectra if not (s['gain']==13.6 and abs(s['vmeas']-7.04) < 1e-6)]
x = np.array([s['vmeas'] for s in fit_pts])
y = np.array([s['peak_ch'] for s in fit_pts])
A = np.vstack([x, np.ones_like(x)]).T
slope, intercept = np.linalg.lstsq(A, y, rcond=None)[0]
y_pred = slope*x + intercept
ss_res = np.sum((y - y_pred)**2)
ss_tot = np.sum((y - np.mean(y))**2)
r2 = 1 - ss_res/ss_tot
print(f"Fit (excluding outlier): channel = {slope:.2f} x V + {intercept:.2f},  R^2 = {r2:.5f}")

fig5, (axA, axB) = plt.subplots(1, 2, figsize=(14,6))
for g in gains:
    runs = sorted([s for s in spectra if s['gain']==g], key=lambda s: s['peak_ch'])
    chans = [s['peak_ch'] for s in runs]
    amps  = [s['vmeas'] for s in runs]
    rates = [s['rate'] for s in runs]
    axA.plot(chans, amps, 'o-', linewidth=2, markersize=8, color=gain_colors[g], label=f'Gain = {g}')
    axB.plot(chans, rates, 'o-', linewidth=2, markersize=8, color=gain_colors[g], label=f'Gain = {g}')

ch_line = np.linspace(min(y)-100, max(y)+100, 50)
v_line = (ch_line - intercept)/slope
axA.plot(ch_line, v_line, 'k--', linewidth=1.5, label='Linear fit (excl. outlier)')
axA.text(0.05, 0.95, f'$R^2$ = {r2:.4f}', transform=axA.transAxes,
         fontsize=12, fontweight='bold', verticalalignment='top')

axA.set_xlabel('MCA Channel Number', fontsize=12, fontweight='bold')
axA.set_ylabel('Amplifier Output Amplitude (V)', fontsize=12, fontweight='bold')
axA.set_title('Amplifier Output Amplitude vs Channel Number', fontsize=12, fontweight='bold')
axA.legend(loc='lower right', fontsize=9)
style_axis(axA)

axB.set_xlabel('MCA Channel Number', fontsize=12, fontweight='bold')
axB.set_ylabel('Net Count Rate (counts/s)', fontsize=12, fontweight='bold')
axB.set_title('Net Peak Count Rate vs Channel Number', fontsize=12, fontweight='bold')
axB.legend(loc='best', fontsize=10)
axB.set_ylim(0, max(s['rate'] for s in spectra)*1.3)
style_axis(axB)

fig5.tight_layout()
fig5.savefig('graph_mca_required.png', dpi=300)
plt.close(fig5)

print("All figures written: graph_integrator.png, graph_window.png, graph_normal.png, "
      "graph_mca_spectra.png, graph_mca_required.png")